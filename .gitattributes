# Normalize line endings to LF in the repository
* text=auto eol=lf

# Never convert line endings in binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

.gitattributes		export-ignore
.gitignore			export-ignore
.github/			export-ignore
docs/images/		export-ignore
tests/				export-ignore
README.md		export-ignore
version-check.json	export-ignore
